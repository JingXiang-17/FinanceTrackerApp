<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <!-- Wrapper to allow stacking the header and the hidden details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- VISIBLE HEADER (Your exact original design) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground">

            <!-- Merchant/Category Icon Box -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_icon_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#F5D0D6"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_transaction_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:tint="#D34B56"
                    tools:src="@android:drawable/ic_menu_camera" />
            </androidx.cardview.widget.CardView>

            <!-- Transaction Title -->
            <TextView
                android:id="@+id/tv_transaction_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_detail_time"
                app:layout_constraintEnd_toStartOf="@id/tv_transaction_amount"
                app:layout_constraintStart_toEndOf="@id/card_icon_bg"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Lunch" />

            <!-- Transaction Date/Time (Renamed ID to match adapter) -->
            <TextView
                android:id="@+id/tv_detail_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:textColor="#888888"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_icon_bg"
                app:layout_constraintTop_toBottomOf="@id/tv_transaction_title"
                tools:text="07-01-2023" />

            <!-- Delete Icon (Renamed ID to btn_delete to match adapter) -->
            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/general_delete"
                app:tint="#D34B56"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Edit Icon (Renamed ID to btn_edit to match adapter) -->
            <ImageView
                android:id="@+id/btn_edit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/general_edit"
                app:tint="#3D82C4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_delete"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Transaction Amount -->
            <TextView
                android:id="@+id/tv_transaction_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="#D34B56"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_edit"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="-RM 32.00" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- HIDDEN EXPANDABLE DETAILS -->
        <LinearLayout
            android:id="@+id/layout_expanded_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_detail_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_detail_merchant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_detail_payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_detail_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#888888"
                android:textStyle="italic"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>