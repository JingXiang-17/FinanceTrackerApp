<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:contentDescription="Dashboard content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- ========================================== -->
            <!-- 0. PERMANENT NON-SHIMMERING BACKGROUND     -->
            <!-- ========================================== -->
            <View
                android:id="@+id/permanent_header_bg"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@color/colorPrimary"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <!-- ========================================== -->
                <!-- 1. THE LOADING PHASE (SHIMMER)             -->
                <!-- ========================================== -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="40dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@color/shimmerBackground" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="100dp"
                                    android:layout_height="12dp"
                                    android:background="@color/shimmerBackground" />

                                <View
                                    android:layout_width="120dp"
                                    android:layout_height="20dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@color/shimmerBackground" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="-48dp"
                            android:layout_marginEnd="24dp"
                            android:background="@color/shimmerBackground" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginTop="40dp"
                            android:background="@color/shimmerBackground" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginTop="48dp"
                            android:background="@color/shimmerBackground" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginHorizontal="24dp"
                            android:layout_marginTop="48dp"
                            android:background="@color/shimmerBackground" />

                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <!-- ========================================== -->
                <!-- 2. THE REAL CONTENT PHASE (Initially GONE) -->
                <!-- ========================================== -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/real_content_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <View
                        android:id="@+id/header_background"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profile_image_card"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="40dp"
                        app:cardCornerRadius="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/iv_profile_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/shimmerBackground"
                            android:src="@drawable/ic_profile_placeholder"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tv_today_spending_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Today's Spending"
                        android:textColor="@color/textOnPrimary"
                        android:textSize="14sp"
                        app:layout_constraintStart_toEndOf="@id/profile_image_card"
                        app:layout_constraintTop_toTopOf="@id/profile_image_card" />

                    <TextView
                        android:id="@+id/tv_total_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text=""
                        tools:text="RM20.00"
                        android:textColor="@color/textOnPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/profile_image_card"
                        app:layout_constraintTop_toBottomOf="@id/tv_today_spending_label" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_add"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="24dp"
                        app:cardBackgroundColor="@color/cardBackground"
                        app:cardCornerRadius="16dp"
                        app:layout_constraintBottom_toBottomOf="@id/profile_image_card"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/profile_image_card">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:src="@drawable/general_add"
                            app:tint="@color/textPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_dashboard_months"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/tv_total_balance"
                        tools:listitem="@layout/item_month" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_budget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/cardBackground"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:layout_constraintTop_toBottomOf="@id/rv_dashboard_months">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tv_budget_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                tools:text="January budget"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_budget_spent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text=""
                                tools:text="RM 100.00"
                                android:textColor="@color/textHighlight"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_budget_title" />

                            <TextView
                                android:id="@+id/tv_budget_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text=""
                                tools:text="/ RM 1,000.00"
                                android:textColor="@color/textSecondary"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="@id/tv_budget_spent"
                                app:layout_constraintStart_toEndOf="@id/tv_budget_spent" />

                            <TextView
                                android:id="@+id/tv_budget_percent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                tools:text="10%"
                                android:textColor="@color/textSecondary"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="@id/tv_budget_total"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <ProgressBar
                                android:id="@+id/progress_budget"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="16dp"
                                android:progress="64"
                                android:progressDrawable="@drawable/custom_progress_bar"
                                app:layout_constraintTop_toBottomOf="@id/tv_budget_spent" />

                            <TextView
                                android:id="@+id/tv_budget_daily"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Daily budget - - -"
                                tools:text="Daily budget - RM 30"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/progress_budget" />

                            <TextView
                                android:id="@+id/tv_budget_days_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="19 days left"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/progress_budget" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ========================================== -->
                    <!-- NEW: FIXED SPENDING SECTION                -->
                    <!-- ========================================== -->
                    <TextView
                        android:id="@+id/tv_fixed_spending_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="32dp"
                        android:text="Fixed Spending"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/card_budget" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_fixed_spending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="24dp"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/cardBackground"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_fixed_spending_title">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tv_fixed_spending_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="RM 0.00"
                                android:textColor="@color/textPrimary"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="This is your fixed spending (e.g., rent, loans). It is excluded from your budget but included in your total spending."
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Original Categories Title (Constraint Updated) -->
                    <TextView
                        android:id="@+id/tv_categories_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="32dp"
                        android:text="Categories"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/card_fixed_spending" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="24dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/tv_categories_title"
                        tools:listitem="@layout/item_category" />

                    <TextView
                        android:id="@+id/tv_transactions_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="32dp"
                        android:text="Transactions"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rv_categories" />

                    <TextView
                        android:id="@+id/tv_transactions_see_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:text="See All"
                        android:textColor="@color/colorAccent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/tv_transactions_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_transactions_title" />

                    <TextView
                        android:id="@+id/tv_transactions_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="8dp"
                        android:text="Today"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_transactions_title" />

                    <TextView
                        android:id="@+id/tv_empty_transactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No transactions yet."
                        android:textAlignment="center"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        android:layout_marginTop="48dp"
                        android:layout_marginStart="24dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/tv_transactions_today"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_transactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:nestedScrollingEnabled="false"
                        android:paddingHorizontal="24dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/tv_transactions_today"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_transaction" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/cardBackground"
        app:elevation="16dp"
        app:labelVisibilityMode="unlabeled"
        app:itemRippleColor="@null"
        app:itemBackground="@drawable/nav_item_bg"
        app:itemIconTint="@drawable/nav_icon_tint"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>