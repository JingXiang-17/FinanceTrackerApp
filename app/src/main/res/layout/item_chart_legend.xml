<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <!-- Color Indicator Box -->
    <View
        android:id="@+id/view_color_indicator"
        android:layout_width="12dp"
        android:layout_height="24dp"
        android:background="#3D82C4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Category Name -->
    <TextView
        android:id="@+id/tv_legend_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#333333"
        android:textSize="12sp"
        android:text=""
        tools:text="Food"
        app:layout_constraintBottom_toTopOf="@id/tv_legend_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_color_indicator"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Amount Spent -->
    <TextView
        android:id="@+id/tv_legend_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text=""
        tools:text="RM 98.90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view_color_indicator"
        app:layout_constraintTop_toBottomOf="@id/tv_legend_category" />

</androidx.constraintlayout.widget.ConstraintLayout>