<?xml version="1.0" encoding="utf-8"?>
<!-- 1. Add the tools namespace here -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 2. Add the tools:replace command here -->
    <application
        android:icon="@mipmap/meowneytrack_beta"
        android:label="Meowney Track Beta"
        android:roundIcon="@mipmap/meowneytrack_beta_round"
        tools:replace="android:icon,android:label,android:roundIcon">

        <!-- Your ML Data Collector service stays exactly the same -->
        <service
            android:name=".service.NotificationListenerBeta"
            android:label="ML Data Collector"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>